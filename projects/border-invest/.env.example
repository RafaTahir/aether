# Public devnet RPC only. Never place private keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-only integrations for later phases.
HELIUS_API_KEY=
DATABASE_URL=
KYC_PROVIDER_API_KEY=

# Supabase Auth + Postgres. The anon key is safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
