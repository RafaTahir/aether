# Public devnet RPC only. Never place private keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional project-bound devnet integration. Leave blank to disable wallet transaction actions.
NEXT_PUBLIC_AETHER_ESCROW_PROJECT_SLUG=
NEXT_PUBLIC_AETHER_ESCROW_ADDRESS=
NEXT_PUBLIC_AETHER_ESCROW_MINT=
NEXT_PUBLIC_AETHER_ESCROW_DECIMALS=6

# Server-only integrations for later phases.
HELIUS_API_KEY=
DATABASE_URL=
KYC_PROVIDER_API_KEY=

# Supabase Auth + Postgres. The anon key is safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
